cuadrados :: [Int]
cuadrados = [x * x | x <- [1..10]]

divisiblesPor3 :: [Int]
divisiblesPor3 = [x | x <- [1..30], x `mod` 3 == 0]

paresOrdenados :: [(Int, Int)]
paresOrdenados = [(x, y) | x <- [1..5], y <- [1..5], x < y]

divisores :: Int -> [Int]
divisores n
    | n <= 0 = []
    | otherwise = [x | x <- [1..n], n `mod` x == 0]

divisoresPropios :: Int -> [Int]
divisoresPropios n
    | n <= 1 = []
    | otherwise = [x | x <- [1..n-1], n `mod` x == 0]

esPerfecto :: Int -> Bool
esPerfecto n = n > 1 && sum (divisoresPropios n) == n
